{
  "compilerOptions": {
    "jsx": "react-jsx", // Or "react" if using older React versions
    "target": "ESNext",
    "module": "ESNext", // ✅ allows import.meta
    "moduleResolution": "Node",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@assets/*": [
        "src/assets/*"
      ],
      "@utils/*": [
        "src/utils/*"
      ],
      "@hooks/*": [
        "src/hooks/*"
      ],
      "@pages/*": [
        "src/pages/*"
      ],
      "@layout/*": [
        "src/layout/*"
      ],
      "@styles/*": [
        "src/styles/*"
      ]
    }
  }
}